# --- Подключение аккаунта WhatsApp (сопряжение по коду) ---
WA_PHONE=                 # номер аккаунта: только цифры, с кодом страны (например 79991234567)
PAIR_KEY=                 # ключ доступа к /pair?key=... и /status?key=... (придумайте длинный)
ALLOWED_NUMBERS=          # кому бот отвечает, кроме чата «Мне» (цифры через запятую)
ALLOW_ALL=0               # 1 — отвечать вообще всем (только для отдельного номера бота!)

# --- Бот ---
DEFAULT_OPENROUTER_KEY=   # необязательно: общий ключ OpenRouter
DEFAULT_MODEL=openrouter/auto
ENCRYPTION_KEY=           # обязателен: шифрует ключи пользователей и бэкапы (python -c "import secrets;print(secrets.token_urlsafe(32))")
HISTORY_CHARS=60000
DATA_DIR=data
PUBLIC_URL=               # на Render берётся из RENDER_EXTERNAL_URL сам
ALLOW_PRIVATE_URLS=0

# --- Free Render: бэкап БД и сессии WhatsApp в приватный GitHub-репозиторий ---
BACKUP_GITHUB_TOKEN=
BACKUP_REPO=
BACKUP_INTERVAL=300
